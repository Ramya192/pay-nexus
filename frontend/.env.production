# Used only by `npm run build` (Vite inlines VITE_-prefixed vars at build
# time, not read at runtime) — npm run dev ignores this file and keeps
# using the empty-string default + vite.config.ts's dev proxy. See
# src/api/client.ts's docstring.
VITE_API_BASE_URL=https://paynexus-api.azurewebsites.net

# Used only by `npm run build` (Vite inlines VITE_-prefixed vars at build
# time, not read at runtime) — npm run dev ignores this file and keeps
# using the empty-string default + vite.config.ts's dev proxy. See
# src/api/client.ts's docstring.
#
# V2's own deployment (separate Azure resources from V1, see README.md's
# Deployment section) — paynexus-api-v2.azurewebsites.net, pointed at the
# paynexus_v2 database, not V1's paynexus_api/paynexus database.
VITE_API_BASE_URL=https://paynexus-api-v2.azurewebsites.net

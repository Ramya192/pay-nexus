# PayNexus — copy to .env and fill in. Never commit the real .env.
OPENAI_API_KEY=your_openai_key_here

# LLM config
USE_LOCAL_SLM=False
OLLAMA_BASE_URL=http://localhost:11434

# Database (pgvector extension enabled on this same database — run once:
# CREATE EXTENSION IF NOT EXISTS vector;)
DATABASE_URL=postgresql://user:password@host:5432/paynexus

# Auth
JWT_SECRET_KEY=your_jwt_secret
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# CORS — comma-separated allowed origins. Add the deployed frontend's origin
# here once it exists, e.g. http://localhost:5173,https://paynexus.azurestaticapps.net
CORS_ORIGINS=http://localhost:5173

# Feature flags
ENABLE_CONTEXT_COMPRESSION=True

# Account Aggregator (Setu sandbox) — sign up at bridge.setu.co/v2/signup, create
# an FIU app -> Account Aggregator Data product, grab these from Step 2 "Testing
# details" (client ID/secret) and the product page (product instance ID). Sandbox
# only — no real bank data, no KYC required. SETU_AA_REDIRECT_URL should match
# both the "Redirect URL" and "Test callback URL" fields set in Setu's dashboard.
SETU_AA_BASE_URL=https://fiu-sandbox.setu.co
SETU_AA_PRODUCT_INSTANCE_ID=your_product_instance_id_here
SETU_AA_CLIENT_ID=your_client_id_here
SETU_AA_CLIENT_SECRET=your_client_secret_here
SETU_AA_REDIRECT_URL=https://your-placeholder-url.free.beeceptor.com
